# Local overrides — see ../docs/STANDARDS.md

# HTTP / gRPC
SERVER_PORT=8081
GRPC_SERVER_PORT=50051
GRPC_PLAYER_ADDRESS=static://localhost:50053

# PostgreSQL (inwza-dev)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=inwza_auth
DB_USER=postgres
DB_PASSWORD=root

# Redis (inwza-dev)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (HS256, >= 32 chars; share access/api secrets with player/inventory/payment locally)
JWT_ACCESS_SECRET_KEY=01234567890123456789012345678901
JWT_REFRESH_SECRET_KEY=01234567890123456789012345678902
JWT_API_SECRET_KEY=01234567890123456789012345678903
JWT_ACCESS_DURATION=3600
JWT_REFRESH_DURATION=604800
